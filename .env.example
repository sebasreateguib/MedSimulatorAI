GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
DATABASE_URL=postgresql+asyncpg://medsim:medsim_password@localhost:5432/medsimulator
# Dónde se guarda el material que suben los usuarios. Relativo a la raíz del
# repo si no es absoluto; `data/` ya está en .gitignore.
MATERIAL_DIR=data/biblioteca
# Tope por documento; lo que se pasa queda en error y se puede reintentar.
TIMEOUT_INGESTA_SEGUNDOS=600
# Carga los modelos de ingesta al arrancar en vez de en la primera subida.
PRECARGAR_MODELOS=true
# Describe con un modelo multimodal las imágenes sin texto legible (ECG, esquemas).
VISION_PARA_IMAGENES=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Obligatorio. Generar uno propio con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
