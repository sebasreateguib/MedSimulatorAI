# Base de la API que consume el frontend.
# Por defecto usa rutas relativas (/api) y el proxy de Vite hacia FastAPI.
# Definila solo si el backend vive en otro origen en producción.
VITE_API_BASE_URL=/api

# Destino del proxy de desarrollo de Vite (solo dev).
VITE_API_PROXY_TARGET=http://localhost:8000
